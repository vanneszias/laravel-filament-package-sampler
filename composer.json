{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework",
        "statik",
        "example"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "artesaos/seotools": "^1.3",
        "filament/filament": "^4.0",
        "filament/spatie-laravel-translatable-plugin": "^3.3",
        "guzzlehttp/guzzle": "^7.9",
        "lara-zeus/spatie-translatable": "^1.0",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "mcamara/laravel-localization": "^2.3",
        "statikbe/laravel-chained-translator": "dev-feature/laravel-13 as 2.5.0",
        "statikbe/laravel-filament-chained-translation-manager": "^4.0",
        "statikbe/laravel-filament-flexible-content-block-pages": "dev-feature/laravel-13",
        "statikbe/laravel-filament-flexible-content-blocks": "dev-feature/laravel-13 as 4.0.4",
        "statikbe/laravel-puppeteer-pdf-converter": "dev-feature/laravel-13",
        "statikbe/laravel-security-txt": "dev-feature/laravel-13",
        "statikbe/laravel-surveyhero": "dev-feature/laravel-13"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11",
        "spatie/laravel-ignition": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/vanneszias/laravel-chained-translator.git",
            "canonical": false
        },
        {
            "type": "vcs",
            "url": "https://github.com/vanneszias/laravel-filament-flexible-content-block-pages.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/vanneszias/laravel-filament-flexible-content-blocks.git",
            "canonical": false
        },
        {
            "type": "vcs",
            "url": "https://github.com/vanneszias/laravel-puppeteer-pdf-converter.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/vanneszias/laravel-security-txt.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/vanneszias/laravel-surveyhero.git"
        }
    ]
}
